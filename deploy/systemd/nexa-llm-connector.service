[Unit]
Description=nexa-llm-connector — dials out to the relay over WSS
After=network-online.target nexa-llm-bridge.service
Wants=network-online.target nexa-llm-bridge.service

[Service]
Type=simple
EnvironmentFile=%h/.config/nexa-llm-bridge/connector.env
ExecStart=%h/nexa-bridge/target/release/nexa-llm-connector
Restart=always
RestartSec=3
# Hardening. NoNewPrivileges is always safe; the namespace-based directives below need
# unprivileged user namespaces in the user manager — uncomment after `systemctl --user
# start` succeeds with them on your distro.
NoNewPrivileges=true
#PrivateTmp=true
#ProtectSystem=strict
#ProtectHome=read-only

[Install]
WantedBy=default.target
